# 로컬에서 테스트할 때 쓰는 예시. 실제 값은 .env 로 복사해서 채운다 (.env 는 커밋 금지).

# Cloud Billing -> BigQuery 내보내기로 생성된 표준 사용량 비용 테이블 (전체 경로)
BQ_BILLING_TABLE=daengs.billing_export.gcp_billing_export_v1_XXXXXX_XXXXXX_XXXXXX

# 디스코드 채널 설정 -> 연동 -> 웹후크에서 발급
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/xxxxx/yyyyy

# 콘솔에 표시되는 총 크레딧 금액 (숫자만)
TOTAL_CREDIT=435523
CREDIT_EXPIRY=2026-11-17
CURRENCY=KRW
PROJECT_LABEL=DAENGS

# 사용률이 이 값을 새로 넘어선 실행에서만 @everyone 멘션
MENTION_THRESHOLDS=50,80,90
MENTION_TARGET=@everyone
# 임계치 돌파 판정 구간. cron 주기와 맞춘다 (하루 2회 = 12)
MENTION_LOOKBACK_HOURS=12

REPORT_TZ=Asia/Seoul
# 무료 체험판 크레딧은 PROMOTION. 무료 등급까지 포함하려면 PROMOTION,FREE_TIER
CREDIT_TYPES=PROMOTION

# 로컬 실행 시에만 필요 (Actions 에서는 google-github-actions/auth 가 처리)
GOOGLE_APPLICATION_CREDENTIALS=C:\path\to\sa-key.json
